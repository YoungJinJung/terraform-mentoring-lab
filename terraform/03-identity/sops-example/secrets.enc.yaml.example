# 이 파일은 "암호화하면 이렇게 보인다"를 보여주는 예시입니다.
# 실제 파일은 아래 순서로 직접 만드세요.
#
#   1) KMS 키 생성 (또는 age 키)
#        aws kms create-key --description tfm-sops
#
#   2) .sops.yaml 작성 — 경로 규칙으로 키를 지정
#        creation_rules:
#          - path_regex: \.enc\.yaml$
#            kms: arn:aws:kms:ap-northeast-2:111122223333:key/xxxx
#            encrypted_regex: '^(password|token|key|secret)'
#
#   3) 평문 작성 후 암호화
#        sops -e -i secrets.enc.yaml
#
# encrypted_regex를 쓰는 이유: 키 이름은 평문으로 남겨두면
# git diff에서 "무엇이 바뀌었는지"는 보이고 값은 안 보입니다.

db:
    host: db.internal              # 평문 — 비밀이 아니므로
    password: ENC[AES256_GCM,data:9Qk...,iv:...,tag:...,type:str]

sops:
    kms:
        - arn: arn:aws:kms:ap-northeast-2:111122223333:key/EXAMPLE
          created_at: "2026-01-01T00:00:00Z"
    encrypted_regex: ^(password|token|key|secret)
    version: 3.13.0
