# ── Terraform ──────────────────────────────────────────────────────
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# ★ 변수 파일에는 계정 ID·CIDR·ARN이 들어갑니다.
#   .example 만 커밋하고 실제 값은 로컬에 둡니다.
*.tfvars
*.tfvars.json
!*.tfvars.example

# backend 설정은 버킷 이름을 담으므로 example 만
backend.tf
!backend.tf.example

# plan 파일은 평문입니다. 절대 커밋하지 마세요.
tfplan
tfplan.*
plan.json
plan.txt

# 공급자 재정의
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc
.terraform.lock.hcl.bak

# ── 비밀 ───────────────────────────────────────────────────────────
# SOPS로 암호화한 파일(.enc.*)은 커밋해도 됩니다. 평문은 안 됩니다.
*.dec.yaml
*.dec.json
secrets.yaml
secrets.json
!*.enc.yaml
!*.enc.json
!*.example
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**

# ── 랩 ─────────────────────────────────────────────────────────────
lab/.env
lab/volumes/
lab/scripts/*.local.sh

# ── 생성물 ─────────────────────────────────────────────────────────
# docs/FLOCI-SUPPORT.md 는 smoke-test.sh 가 덮어씁니다 — 커밋해도 괜찮습니다
terraform/09-observability/canary/canary.zip
terraform/09-observability/canary/nodejs/

# ── 에디터 / OS ────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*~
__pycache__/

# bootstrap.sh 가 만드는 _shared 복사본
terraform/*/_shared_*.tf
