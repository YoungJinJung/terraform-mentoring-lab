        <mxCell id="w2" value="&lt;b&gt;보안 체크리스트&lt;/b&gt;&lt;br&gt;· &lt;span style=&quot;font-family:monospace&quot;&gt;--repo-allowlist&lt;/span&gt;를 좁게&lt;br&gt;· &lt;span style=&quot;font-family:monospace&quot;&gt;--gh-webhook-secret&lt;/span&gt; 필수 (ALB가 공개되어 있음)&lt;br&gt;· &lt;span style=&quot;font-family:monospace&quot;&gt;allowed_overrides&lt;/span&gt; 제한 — PR로 승인 요건을 지울 수 있음&lt;br&gt;· 이미지 버전 고정 + 보안 패치 신속 적용" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="540" height="90" as="geometry" />
        </mxCell>
      </root>
