        <mxCell id="n2" value="Lambda가 &lt;span style=&quot;font-family:monospace&quot;&gt;IN_PROGRESS&lt;/span&gt;를 반복 반환하면 15분 타임아웃을 넘어 &lt;b&gt;최대 24시간&lt;/b&gt;까지 검증을 이어갈 수 있습니다. CodeDeploy 훅은 총 1시간 제한입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="745" width="1080" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;circuit breaker는 rolling 전용&lt;/b&gt;입니다. Blue/Green의 안전장치는 lifecycle hook + CloudWatch 알람 + bake time입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="1080" height="20" as="geometry" />
        </mxCell>
