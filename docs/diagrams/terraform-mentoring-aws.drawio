        <mxCell id="n1" value="&lt;b&gt;lifecycle hook 단계&lt;/b&gt; — RECONCILE_SERVICE → PRE_SCALE_UP → POST_SCALE_UP → TEST_TRAFFIC_SHIFT → &lt;b&gt;POST_TEST_TRAFFIC_SHIFT&lt;/b&gt; → PRE_PRODUCTION_TRAFFIC_SHIFT → PRODUCTION_TRAFFIC_SHIFT → &lt;b&gt;POST_PRODUCTION_TRAFFIC_SHIFT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1">
